{
    "name": "yogiarta-portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:prod": "dotenv run -f .env.production.local -- drizzle-kit migrate",
        "db:migrate:test": "dotenv run -f .env.test.local -- drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:check": "tsx scripts/db-check.ts",
        "seed:admin": "tsx scripts/seed-admin.ts",
        "seed:admin:prod": "dotenv run -f .env.production.local -- tsx scripts/seed-admin.ts",
        "seed:content": "tsx scripts/seed-content.ts",
        "admin:set-password": "tsx scripts/set-admin-password.ts",
        "admin:set-password:prod": "dotenv run -f .env.production.local -- tsx scripts/set-admin-password.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@neondatabase/serverless": "^1.2.0",
        "@vercel/blob": "^2.8.2",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "drizzle-orm": "^0.45.4",
        "jose": "^6.2.15",
        "lucide-react": "^1.70.0",
        "next": "16.4.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-markdown": "^10.1.0",
        "rehype-sanitize": "^6.0.0",
        "server-only": "^0.0.1",
        "shadcn": "^4.23.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^18.0.9",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.4.5",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@12.18.0"
}
